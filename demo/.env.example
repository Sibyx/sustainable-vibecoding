# Google Ads API Credentials
#
# How to get these:
# 1. Go to https://ads.google.com/aw/apicenter
# 2. Create an API project and enable Google Ads API
# 3. Generate OAuth 2.0 credentials
# 4. Copy the values below

# Your Google Ads API developer token (looks like: ABcdeFGH1234567890)
GOOGLE_ADS_API_KEY=your-key-here

# OAuth 2.0 Client ID (looks like: 123456789-abc123xyz.apps.googleusercontent.com)
GOOGLE_ADS_CLIENT_ID=your-client-id-here

# OAuth 2.0 Refresh Token (long string you get after first authentication)
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token-here

# Google Ads Customer ID (10-digit number, without dashes)
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Where to save the output CSV files
OUTPUT_DIR=./data

# IMPORTANT: After filling in your real values, rename this file to just ".env"
# Never commit the real .env file to git — it contains your secrets!